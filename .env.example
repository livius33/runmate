# Copy to .env.local and fill in. Never commit real values. See README.md → Environment variables.

# Database (Neon / Postgres). Docker Compose builds DATABASE_URL itself from POSTGRES_PASSWORD (letters and digits only).
DATABASE_URL=
POSTGRES_PASSWORD=
# neon | pg — only to override the guess (*.neon.tech → neon HTTP driver, anything else → node-postgres)
DATABASE_DRIVER=

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk's sign-up page; open only with BILLING_ENABLED, otherwise it leads to the waitlist
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated emails allowed to sign in; empty = any signed-in Clerk user
ALLOWED_EMAILS=

# Encrypts each user's Garmin login and session at rest (AES-256-GCM): 32 random bytes, e.g. `openssl rand -base64 32`
ENCRYPTION_KEY=

# Vercel Cron (daily sync of every user with a connected pull source, e.g. the Garmin login; with billing on also the
# daily reconciliation with Paddle)
CRON_SECRET=

# Public host for calendar and Apple Health links, e.g. www.example.com (default: the request host). When set, Clerk
# session tokens must come from https://<APP_HOST> (or the host serving the request) and signed-in routes refuse
# POST/PUT/PATCH/DELETE sent from another site.
APP_HOST=

# Clerk webhook (user.deleted → delete all of the user's data): signing secret of the endpoint /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# Billing (hosted only). Unset = self-host: no prices, no trial, every feature, no health-data consent prompt.
BILLING_ENABLED=
# Ask for the Art. 9 health-data consent without billing (self-hosters serving other people): 1
REQUIRE_HEALTH_CONSENT=
# Paddle Billing: exactly sandbox or production. Checkout is offered only when this, the API key, the webhook secret,
# the client token and at least one price id are set (otherwise one line in the log at start-up).
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Plus is the only paid plan (9 €/month, 79 €/year); a hosted account without it is Free.
PADDLE_PRICE_PLUS_MONTH=
PADDLE_PRICE_PLUS_YEAR=

# Landing page (Phase 6). Read at build time: the marketing pages are static.
# Canonical origin (sitemap, hreflang, OG, JSON-LD); default https://runmate.dev
NEXT_PUBLIC_SITE_URL=
# Public repository URL; the GitHub links appear only when set
NEXT_PUBLIC_REPO_URL=
# 1 = cookieless Vercel Web Analytics on the marketing pages
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Demo deployment only (Phase 5): 1 = serve the read-only demo athlete under /demo without login; seed with
# scripts/seed-demo.mts. Unset on every other instance.
DEMO_MODE=
