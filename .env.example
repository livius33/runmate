# Copy to .env.local and fill in. Never commit real values. See README.md → Environment variables.

# Database (Neon / Postgres)
DATABASE_URL=

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed to sign in; empty = any signed-in Clerk user
ALLOWED_EMAILS=

# Vercel Cron (daily Garmin sync)
CRON_SECRET=

# Garmin Connect (unofficial login, experimental)
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Public host for calendar and Apple Health links, e.g. www.example.com (default: the request host)
APP_HOST=
